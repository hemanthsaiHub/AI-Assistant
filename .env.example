# Get this free from @BotFather on Telegram (see README section 1)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Which free LLM provider to use: "groq" or "google"
LLM_PROVIDER=groq

# Groq (free) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Max chat turns to remember per user before trimming history
MAX_HISTORY_TURNS=10
